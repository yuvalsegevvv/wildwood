{
  "name": "wildwood",
  "version": "1.0.0",
  "description": "Wildwood: a multiplayer 3D forest RPG in the browser (three.js), with a Node world server that keeps players' progress (files or Postgres).",
  "private": true,
  "scripts": {
    "build": "python3 build.py",
    "check": "python3 build.py --check",
    "start": "node dist/wildwood-server.js",
    "dev": "python3 build.py && node dist/wildwood-server.js",
    "test": "python3 build.py --check && node tools/run-tests.js --all",
    "test:fast": "python3 build.py --check && node tools/run-tests.js --fast",
    "test:changed": "node tools/run-tests.js",
    "test:server": "node tools/run-tests.js --group server",
    "test:client": "node tools/run-tests.js --group client",
    "test:keys": "python3 build.py >/dev/null && node tools/keys-smoke.js",
    "test:accounts": "node tools/accounts-smoke.js",
    "lint": "node tools/lint-bundles.js",
    "doctor": "node tools/doctor.js",
    "fuzz": "node tools/server-fuzz.js",
    "bench": "node tools/server-bench.js",
    "unused": "python3 tools/unused.py",
    "docs": "node tools/gen-docs.js",
    "docs:check": "node tools/gen-docs.js --check",
    "preview:model": "node tools/model-preview.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "UNLICENSED",
  "optionalDependencies": {
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "three": "0.128.0"
  }
}
